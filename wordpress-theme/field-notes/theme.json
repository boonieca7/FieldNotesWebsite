{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "navy", "name": "Harbor navy", "color": "#1C2F3C" },
				{ "slug": "navy-deep", "name": "Navy deep", "color": "#16252F" },
				{ "slug": "slate", "name": "Slate sea", "color": "#4A6274" },
				{ "slug": "ink", "name": "Ink", "color": "#2E4352" },
				{ "slug": "kraft", "name": "Kraft", "color": "#C9AE86" },
				{ "slug": "paper", "name": "Paper", "color": "#F5EEE6" },
				{ "slug": "stone", "name": "Stone", "color": "#CFCFCA" },
				{ "slug": "mist", "name": "Mist", "color": "#CFD7DD" },
				{ "slug": "red", "name": "Mărțișor red", "color": "#B3362C" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"spacing": {
			"units": [ "px", "rem", "%" ],
			"padding": true
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "serif", "name": "Source Serif 4", "fontFamily": "'Source Serif 4', Georgia, serif" },
				{ "slug": "condensed", "name": "Barlow Condensed", "fontFamily": "'Barlow Condensed', 'Arial Narrow', sans-serif" },
				{ "slug": "mono", "name": "IBM Plex Mono", "fontFamily": "'IBM Plex Mono', ui-monospace, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.15rem" },
				{ "slug": "large", "name": "Large", "size": "1.6rem", "fluid": { "min": "1.35rem", "max": "1.6rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.6rem", "fluid": { "min": "1.9rem", "max": "2.6rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.4rem", "fluid": { "min": "2.3rem", "max": "3.4rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--navy)" },
		"spacing": {
			"padding": { "left": "clamp(18px, 4vw, 32px)", "right": "clamp(18px, 4vw, 32px)", "top": "0", "bottom": "0" },
			"blockGap": "1.4rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--serif)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				":hover": { "color": { "text": "var(--wp--preset--color--red)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--serif)", "fontWeight": "600", "lineHeight": "1.15" }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--navy)", "text": "var(--wp--preset--color--paper)" },
				"border": { "radius": "0" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontWeight": "600", "fontSize": "1.1rem", "letterSpacing": "0.12em", "textTransform": "uppercase" },
				":hover": { "color": { "background": "var(--wp--preset--color--red)", "text": "var(--wp--preset--color--white)" } }
			},
			"caption": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.8rem", "letterSpacing": "0.04em" },
				"color": { "text": "var(--wp--preset--color--slate)" }
			}
		},
		"blocks": {
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--red)", "width": "3px", "style": "solid" } },
				"spacing": { "padding": { "left": "1.4rem" } },
				"typography": { "fontStyle": "italic" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": []
}
